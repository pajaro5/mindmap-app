{
  "name": "mindmap-app",
  "productName": "Mapas Mentales",
  "version": "1.0.0",
  "description": "Mapas mentales al estilo de MindManager",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test tests/unit/*.test.js && playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:changed": "node scripts/test-changed.js",
    "test:stats": "node scripts/test-report.js",
    "test:e2e": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:desktop": "playwright test --config=tests/desktop/playwright.config.js",
    "test:report": "playwright show-report"
  },
  "keywords": [],
  "author": "Pablo Robayo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "simple-mind-map": "^0.14.0-fix.3"
  },
  "build": {
    "appId": "com.pablorobayo.mapasmentales",
    "productName": "Mapas Mentales",
    "copyright": "Pablo Robayo",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "desktop/**",
      "server/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mapas Mentales",
      "installerLanguages": ["es_ES"],
      "language": "3082",
      "deleteAppDataOnUninstall": false,
      "artifactName": "MapasMentales-Setup-${version}.${ext}"
    }
  }
}
